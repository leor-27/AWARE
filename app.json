{
  "expo": {
    "name": "AWARE",
    "slug": "aware-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4F4F2"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "AWARE uses the camera for Smart Vision object and obstacle detection.",
        "NSLocationWhenInUseUsageDescription": "AWARE uses your location for navigation guidance and emergency SOS sharing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
